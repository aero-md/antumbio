# PostgreSQL — DB dédupliquant les vues
DATABASE_URL=postgres://user:password@localhost:5432/redsunsbio_test

# Pseudo cible du redirect depuis /
DEFAULT_PSEUDO=_example

# Secret serveur pour le HMAC d'identité visiteur (plan sécurité #03).
# Jamais exposé au client. Générer un secret aléatoire fort par environnement, p.ex. :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
VISITOR_SECRET=change-me-strong-random-secret

# (optionnel) Token d'une app Discord dédiée, utilisée pour résoudre la PP courante
# d'un user opt-in via `useDiscordPfp: true` + `discordUserId` dans config.json.
# Créer l'app : https://discord.com/developers/applications → New Application → Bot → Reset Token.
# Aucun scope/intent particulier requis ; le bot n'a pas besoin d'être présent dans un serveur.
# Si absent, la feature est désactivée silencieusement (un seul warn au premier hit).
DISCORD_BOT_TOKEN=
